[36m(main_task pid=3409)[0m C=(11,0);
[36m(main_task pid=3409)[0m D=(9.33,2.66);
[36m(main_task pid=3409)[0m I=(7.5,0);
[36m(main_task pid=3409)[0m T=(6.5,2);
[36m(main_task pid=3409)[0m label("$T$",T,NW);
[36m(main_task pid=3409)[0m label("$D$",D,NE);
[36m(main_task pid=3409)[0m label("$E$",I,S);
[36m(main_task pid=3409)[0m label("$A$",A,S);
[36m(main_task pid=3409)[0m label("$C$",C,S);
[36m(main_task pid=3409)[0m label("$B$",B,N);
[36m(main_task pid=3409)[0m draw(A--B--C--cycle,linewidth(0.7));
[36m(main_task pid=3409)[0m draw(A--D,linewidth(0.7));
[36m(main_task pid=3409)[0m draw(B--I,linewidth(0.7));
[36m(main_task pid=3409)[0m [/asy]
