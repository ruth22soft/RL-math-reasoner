[36m(main_task pid=3409)[0m 
[36m(main_task pid=3409)[0m [asy]
[36m(main_task pid=3409)[0m size(250);
[36m(main_task pid=3409)[0m pair A,B,C,D,M,BB,CC,EE;
[36m(main_task pid=3409)[0m B = (0,0);
[36m(main_task pid=3409)[0m D = (10,0);
[36m(main_task pid=3409)[0m M = (15,0);
[36m(main_task pid=3409)[0m C=2*M;
[36m(main_task pid=3409)[0m A = D + (scale(1.2)*rotate(aCos((225-144-25)/120))*(M-D));
[36m(main_task pid=3409)[0m CC = D + D + D - A - A;
[36m(main_task pid=3409)[0m BB = reflect(A,M)*B;
[36m(main_task pid=3409)[0m EE = reflect(A,M)*D;
